# Copy to server/.env and replace the secrets. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATABASE_URL=postgresql://followcare:followcare@localhost:5432/followcare
REDIS_URL=redis://localhost:6379

SESSION_SECRET=replace-with-64-hex-chars
PHI_ENC_KEY=replace-with-64-hex-chars   # must be exactly 64 hex characters (AES-256-GCM key)

PORT=3001
CLIENT_URL=http://localhost:5173
NOTIFY_PROVIDER=mock
FAIL_RATE=0.0
CLINIC_TZ=Asia/Kolkata
NODE_ENV=development

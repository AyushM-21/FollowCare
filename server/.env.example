# Copy to server/.env and replace the secrets. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATABASE_URL=postgresql://followcare:followcare@localhost:5432/followcare
REDIS_URL=redis://localhost:6379

SESSION_SECRET=replace-with-64-hex-chars
PHI_ENC_KEY=replace-with-64-hex-chars   # must be exactly 64 hex characters (AES-256-GCM key)

PORT=3001
CLIENT_URL=http://localhost:5173
NOTIFY_PROVIDER=mock
FAIL_RATE=0.0

# Optional Twilio SMS/WhatsApp demo integration. Keep secrets out of git.
# Set NOTIFY_PROVIDER=twilio only after filling in the required values.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
# Public HTTPS origin used to validate Twilio status callbacks (no trailing slash).
# Example: PUBLIC_API_URL=https://your-demo-api.example.com
PUBLIC_API_URL=
CLINIC_TZ=Asia/Kolkata
NODE_ENV=development
